.386
.model flat, stdcall
.stack 4096
ExitProcess PROTO, dwExitCode:DWORD

.data
	
	array DWORD 5, 10, 15, 20, 25 ; defining the array

.code

main PROC
	mov ecx, 8 ;
	mov eax, [array + TYPE array * 0]
	mul ecx ;
	mov [array + TYPE array * 0], eax

;2nd ele

	mov eax, [array + TYPE array * 1]
	mul ecx ;
	mov [array + TYPE array * 1], eax

;3rd ele
	mov eax, [array + TYPE array * 2]
	mul ecx ;
	mov [array + TYPE array * 2], eax

;4th ele
	mov eax, [array + TYPE array * 3]
	mul ecx ;
	mov [array + TYPE array * 3], eax
	INVOKE ExitProcess, 0

main ENDP
END main
